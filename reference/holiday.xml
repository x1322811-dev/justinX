      // 获取农历月份中文
      getLunarMonthText(month) {
        const monthTexts = ['', '正月','二月','三月','四月','五月','六月','七月','八月','九月','十月','冬月','腊月'];
        return monthTexts[month];
      }
      
      // 获取完整农历信息
      getLunarInfo(date) {
        const year = date.getFullYear();
        const month = date.getMonth() + 1;
        const day = date.getDate();
        
        // 优先检查公历节日(如清明节)
        const solarDateKey = `${month}-${day}`;
        const solarFestival = this.solarFestivals[year] ? this.solarFestivals[year][solarDateKey] : null;
        if (solarFestival) {
          return { text: solarFestival, type: 'festival' };
        }
        
        const lunar = this.solar2lunar(date);
        const festivalKey = `${lunar.month}-${lunar.day}`;
        const festival = this.festivals[festivalKey];
        
        // 优先显示节日,其次显示初一,最后显示日期
        if (festival) {
          return { text: festival, type: 'festival' };
        } else if (lunar.day === 1) {
          return { text: this.getLunarMonthText(lunar.month), type: 'month' };
        } else {
          return { text: this.getLunarDayText(lunar.day), type: 'day' };
        }
      }
