      // 获取农历月份天数
      monthDays(y, m) {
        return (this.lunarInfo[y - 1900] & (0x10000 >> m)) ? 30 : 29;
      }
      
      // 公历转农历
      solar2lunar(date) {
        const baseDate = new Date(1900, 0, 31);
        let offset = Math.floor((date - baseDate) / 86400000);
        
        let year = 1900;
        let daysInYear = 0;
        
        while (year < 2101 && offset > 0) {
          daysInYear = this.lYearDays(year);
          offset -= daysInYear;
          year++;
        }
        
        if (offset < 0) {
          offset += daysInYear;
          year--;
        }
        
        const leap = this.leapMonth(year);
        let isLeap = false;
        
        let month = 1;
        for (month = 1; month < 13 && offset > 0; month++) {
          if (leap > 0 && month === (leap + 1) && !isLeap) {
            --month;
            isLeap = true;
            daysInYear = this.leapDays(year);
          } else {
            daysInYear = this.monthDays(year, month);
          }
          
          if (isLeap && month === (leap + 1)) {
            isLeap = false;
          }
          
          offset -= daysInYear;
        }
        
        if (offset === 0 && leap > 0 && month === leap + 1) {
          if (isLeap) {
            isLeap = false;
          } else {
            isLeap = true;
            --month;
          }
        }
        
        if (offset < 0) {
          offset += daysInYear;
          --month;
        }
        
        const day = offset + 1;
        
        return {
          year,
          month,
          day,
          isLeap
        };
      }
      
