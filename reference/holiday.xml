        const today = new Date();
        today.setHours(0, 0, 0, 0); // 重置时间为当天0点,便于比较
        
        this.holidays.forEach(holiday => {
          const startDate = new Date(holiday.startDate);
          startDate.setHours(0, 0, 0, 0);
          
          // 如果当前日期 >= 假期开始日期,则为"已休"
          if (today >= startDate) {
            holiday.status = '已休';
          } else {
            holiday.status = '未休';
          }
        });
      }

      init() {
        this.updateHolidayStatus(); // 在渲染前更新状态
        this.renderHolidayList();
      }

      formatDate(dateStr) {
        const date = new Date(dateStr);
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        return `${month}月${day}日`;
      }

      renderHolidayList() {
        const listContainer = document.getElementById('holidayList');
        listContainer.innerHTML = '';

        this.holidays.forEach((holiday, index) => {
          const holidayItem = document.createElement('div');
          holidayItem.className = 'holiday-item';
          
          const isExpanded = this.expandedIndex === index;
          
          holidayItem.innerHTML = `
            <div class="holiday-row" data-index="${index}">
              <div class="holiday-divider"></div>
              <div class="holiday-info">
                <div class="info-name">${holiday.name}</div>
                <div class="info-date">${this.formatDate(holiday.startDate)} - ${this.formatDate(holiday.endDate)}</div>
                <div class="info-days">${holiday.days}天</div>
                <div class="info-status">${holiday.status}</div>
                <div class="info-arrow ${isExpanded ? 'expanded' : ''}">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M3 4.5L6 7.5L9 4.5" stroke="#999999" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </div>
            </div>
            ${isExpanded ? this.renderCalendar(holiday, index) : ''}
          `;

          listContainer.appendChild(holidayItem);
        });

        // 绑定点击事件
        document.querySelectorAll('.holiday-row').forEach(row => {
          row.addEventListener('click', (e) => {
            const index = parseInt(e.currentTarget.dataset.index);
            this.toggleExpand(index);
          });
        });
      }

      toggleExpand(index) {
        if (this.expandedIndex === index) {
          this.expandedIndex = null;
        } else {
          this.expandedIndex = index;
        }
        this.renderHolidayList();
      }

      renderCalendar(holiday, holidayIndex) {
        const startDate = new Date(holiday.startDate);
        const endDate = new Date(holiday.endDate);
        
        // 获取日历显示的月份范围
        const startMonth = new Date(startDate.getFullYear(), startDate.getMonth(), 1);
        const endMonth = new Date(endDate.getFullYear(), endDate.getMonth() + 1, 0);
        
        let calendarHTML = '<div class="calendar-container">';
        
        // 生成每个月的日历
        let currentMonth = new Date(startMonth);
        while (currentMonth <= endMonth) {
          calendarHTML += this.renderMonthCalendar(currentMonth, holiday);
          currentMonth = new Date(currentMonth.getFullYear(), currentMonth.getMonth() + 1, 1);
        }
        
        calendarHTML += '</div>';
        return calendarHTML;
      }

      renderMonthCalendar(monthDate, holiday) {
        const year = monthDate.getFullYear();
        const month = monthDate.getMonth();
        const firstDay = new Date(year, month, 1);
        const lastDay = new Date(year, month + 1, 0);
        const daysInMonth = lastDay.getDate();
        const startDayOfWeek = firstDay.getDay();

        let html = `
          <div class="month-calendar">
            <div class="month-header">${year}年${month + 1}月</div>
            <div class="weekdays">
              <div class="weekday">日</div>
              <div class="weekday">一</div>
              <div class="weekday">二</div>
              <div class="weekday">三</div>
              <div class="weekday">四</div>
              <div class="weekday">五</div>
              <div class="weekday">六</div>
            </div>
            <div class="days-grid">
        `;

        // 填充空白日期
        for (let i = 0; i < startDayOfWeek; i++) {
          html += '<div class="day empty"></div>';
        }

        // 填充日期
        for (let day = 1; day <= daysInMonth; day++) {
          const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
          const isVacation = holiday.vacationDays.includes(dateStr);
          const isWorkDay = holiday.workDays.includes(dateStr);
          
          // 获取农历信息
          const currentDate = new Date(year, month, day);
          const lunarInfo = this.lunarCalendar.getLunarInfo(currentDate);
          const lunarClass = lunarInfo.type === 'festival' ? 'day-lunar festival' : 'day-lunar';
          
          let dayClass = 'day';
          let label = '';
          
          if (isVacation) {
            dayClass += ' vacation';
            label = '<span class="day-label vacation-label">休</span>';
          } else if (isWorkDay) {
            dayClass += ' workday';
            label = '<span class="day-label workday-label">班</span>';
          }

          html += `
            <div class="${dayClass}">
              <span class="day-number">${day}</span>
              <span class="${lunarClass}">${lunarInfo.text}</span>
              ${label}
            </div>
          `;
        }

        html += `
            </div>
          </div>
        `;

        return html;
      }
    }

    // 初始化
    document.addEventListener('DOMContentLoaded', () => {
      new HolidaySchedule();
    });
  
  </script>
